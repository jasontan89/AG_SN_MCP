# ==============================================================================
# MCP Server Configuration
# ==============================================================================
# Port for the Express server (Render automatically sets PORT in production)
PORT=3000

# Secret key required to access this MCP server over the public internet
# Clients must send this via 'Authorization: Bearer <key>' header or '?token=<key>' query param
MCP_API_KEY=your_secure_mcp_api_key_here

# ==============================================================================
# ServiceNow PDI Connection Configuration
# ==============================================================================
# Your ServiceNow instance URL (e.g., https://dev12345.service-now.com)
SERVICENOW_INSTANCE_URL=https://devXXXXX.service-now.com

# Authentication Type: 'oauth' (recommended) or 'basic'
SERVICENOW_AUTH_TYPE=oauth

# --- OAuth 2.0 Settings (required when SERVICENOW_AUTH_TYPE=oauth) ---
SERVICENOW_CLIENT_ID=your_oauth_client_id
SERVICENOW_CLIENT_SECRET=your_oauth_client_secret

# OAuth Grant Type: 'client_credentials' or 'password'
# - 'client_credentials': Uses Client ID & Secret directly (standard machine-to-machine)
# - 'password': Uses Client ID & Secret + Username & Password (common for ServiceNow external API clients)
SERVICENOW_OAUTH_GRANT_TYPE=client_credentials

# --- User Credentials (required for 'password' grant or when SERVICENOW_AUTH_TYPE=basic) ---
SERVICENOW_USERNAME=admin
SERVICENOW_PASSWORD=your_instance_password
